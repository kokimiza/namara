/*
  Content-Security-Policy: default-src 'self'; script-src 'none'; object-src 'none'; frame-src 'none'; frame-ancestors 'none'; base-uri 'none'; form-action 'none'
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# doc/ is internal planning material (requirements/design docs), not product content.
# It deploys to the Pages build root along with everything else, so keep it out of search results.
/doc/*
  X-Robots-Tag: noindex, nofollow
