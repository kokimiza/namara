/*
  Content-Security-Policy: default-src 'none'; style-src 'self'; script-src 'none'; object-src 'none'; frame-src 'none'; frame-ancestors 'none'; base-uri 'none'; form-action 'none'
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload

# doc/ and script/ are internal material (design docs, the local content-authoring
# script), not product content. Both deploy to the Pages build root along with
# everything else, so keep them out of search results.
/doc/*
  X-Robots-Tag: noindex, nofollow

/script/*
  X-Robots-Tag: noindex, nofollow
